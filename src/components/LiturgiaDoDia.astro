---
import { liturgia, type LiturgiaTexto } from "../data/liturgia";
import { getBrasiliaDateParts } from "../utils/brasilia-date";

const entry = liturgia[getBrasiliaDateParts().isoDate];

const leituras: { titulo: string; leitura?: LiturgiaTexto }[] = entry
  ? [
      { titulo: "Evangelho", leitura: entry.evangelho },
      { titulo: "Primeira Leitura", leitura: entry.primeiraLeitura },
      { titulo: "Salmo Responsorial", leitura: entry.salmo },
      { titulo: "Segunda Leitura", leitura: entry.segundaLeitura },
    ].filter((item) => item.leitura?.texto)
  : [];

// Cada linha vira um parágrafo; "Missa da Vigília", "Missa do dia" etc. viram subtítulos
// (dias de festa trazem as leituras de mais de uma missa no mesmo texto).
const toBlocks = (texto: string) =>
  texto
    .split("\n")
    .map((linha) => linha.replace(/\s*\*\s*$/, "").trim())
    .filter(Boolean)
    .map((linha) => ({ linha, isMissa: /^Missa (da|do) /i.test(linha) }));
---

<section class="daily-section">
  <div class="daily-card">
    <div class="daily-content">
      <div class="kicker">Liturgia do Dia</div>
      {
        leituras.length ? (
          leituras.map(({ titulo, leitura }) => (
            <article class="daily-reading">
              <h3>{titulo}</h3>
              <p class="daily-ref">{leitura!.referencia}</p>
              {leitura!.refrao && <p class="daily-refrao">R. {leitura!.refrao}</p>}
              {toBlocks(leitura!.texto).map(({ linha, isMissa }) =>
                isMissa ? <h4>{linha}</h4> : <p class="daily-text">{linha}</p>
              )}
            </article>
          ))
        ) : (
          <p class="daily-text">Liturgia de hoje ainda não cadastrada.</p>
        )
      }
    </div>
  </div>
</section>
