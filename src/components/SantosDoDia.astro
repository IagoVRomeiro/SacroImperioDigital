---
import { meses, santos } from "../data/santos";
import { getSantoDeHoje, getSantoHref } from "../utils/santos";

const { day, mes: mesAtual, santo: santoDeHoje } = getSantoDeHoje();
---

<section class="santos-do-dia" aria-live="polite">
  <div class="santo-highlight">
    <div class="kicker">Santo do dia</div>
    <h3 class="santo-title">{santoDeHoje ? santoDeHoje.title : "Sem dados para este dia"}</h3>
    <p class="santo-date">Dia {day} de {mesAtual.nome}</p>
  </div>

  <div class="month-nav">
    <span class="kicker">Mês</span>
    <div class="month-controls">
      <button class="month-btn" type="button" data-step="-1" aria-label="Mês anterior">←</button>
      <select class="month-select" aria-label="Escolher mês">
        {meses.map((mes) => <option value={mes.slug} selected={mes.slug === mesAtual.slug}>{mes.nome}</option>)}
      </select>
      <button class="month-btn" type="button" data-step="1" aria-label="Próximo mês">→</button>
    </div>
  </div>

  {
    meses.map((mes) => (
      <div class="santos-grid" data-month={mes.slug} hidden={mes.slug !== mesAtual.slug}>
        {santos[mes.slug].map((santo) => (
          <a href={getSantoHref(mes.slug, santo)} class="saint-card-link">
            <article class:list={["saint-card", { "is-today": mes.slug === mesAtual.slug && santo.day === day }]}>
              <div class="card-media" style={`background-image: url('${encodeURI(santo.image)}')`} />
              <div class="card-footer">
                <div class="card-day">Dia {santo.day}</div>
                <h3>{santo.title}</h3>
                <p>{mes.nome}</p>
              </div>
            </article>
          </a>
        ))}
      </div>
    ))
  }
</section>

<script>
  const root = document.querySelector<HTMLElement>(".santos-do-dia");
  const select = root?.querySelector<HTMLSelectElement>(".month-select");
  const grids = root?.querySelectorAll<HTMLElement>(".santos-grid") ?? [];

  const showMonth = (slug: string) => {
    if (select) select.value = slug;
    grids.forEach((grid) => (grid.hidden = grid.dataset.month !== slug));
  };

  select?.addEventListener("change", () => showMonth(select.value));
  root?.querySelectorAll<HTMLButtonElement>(".month-btn").forEach((button) => {
    button.addEventListener("click", () => {
      if (!select) return;
      const total = select.options.length;
      const next = (select.selectedIndex + Number(button.dataset.step) + total) % total;
      showMonth(select.options[next].value);
    });
  });
</script>

<style>
  .santos-do-dia {
    margin-top: 2rem;
    display: grid;
    gap: 2rem;
  }
  .month-nav {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }
  .month-controls {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .month-select {
    background: rgba(11, 14, 21, 0.7);
    border: 1px solid var(--accent-soft);
    color: var(--ink);
    padding: 0.5rem 1.25rem;
    border-radius: 999px;
    letter-spacing: 0.1em;
  }
  .month-btn {
    width: 42px;
    height: 42px;
    border-radius: 999px;
    border: 1px solid var(--accent-soft);
    background: rgba(11, 14, 21, 0.6);
    color: var(--ink);
    font-size: 1.1rem;
    cursor: pointer;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease;
  }
  .month-btn:hover {
    transform: translateY(-1px);
    border-color: rgba(210, 182, 117, 0.4);
  }
  .santo-highlight {
    border: 1px solid var(--accent-soft);
    border-radius: 16px;
    padding: 1.5rem;
    background: rgba(11, 14, 21, 0.6);
    text-align: center;
    box-shadow: 0 16px 32px rgba(0, 0, 0, 0.35);
  }
  .santo-title {
    font-family: var(--font-display);
    font-size: 1.9rem;
    margin: 0 0 0.5rem;
  }
  .santo-date {
    margin: 0;
    color: var(--muted);
  }
  .santos-grid {
    display: grid;
    gap: 2rem;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  .santos-grid[hidden] {
    display: none;
  }
  .saint-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    border-radius: 18px;
    overflow: hidden;
    background: var(--card);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.45);
    border: 1px solid rgba(210, 182, 117, 0.3);
  }
  .saint-card.is-today {
    border-color: rgba(210, 182, 117, 0.9);
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.55);
  }
  .card-media {
    height: 300px;
    background-size: cover;
    background-position: center;
    position: relative;
  }
  .card-media::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(4, 6, 10, 0) 20%, rgba(4, 6, 10, 0.85) 100%);
  }
  .card-footer {
    flex: 1;
    padding: 1.4rem 1.6rem 1.5rem;
    background: #0a1220;
  }
  .card-day {
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .card-footer h3 {
    font-family: var(--font-display);
    font-size: 1.4rem;
    margin: 0.25rem 0;
  }
  .card-footer p {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
  }
  @media (max-width: 1100px) {
    .santos-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 720px) {
    .santos-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
