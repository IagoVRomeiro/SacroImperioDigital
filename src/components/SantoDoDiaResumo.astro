---
import { getSantoDeHoje, getSantoHref } from "../utils/santos";

const { day, mes, santo } = getSantoDeHoje();
const image = santo ? encodeURI(santo.image) : "/assets/fundo.png";
---

<a href={santo ? getSantoHref(mes.slug, santo) : "/santos-do-dia"} class="santo-resumo">
  <div class="santo-media" style={`background-image: url('${image}')`}></div>
  <div class="santo-body">
    <div class="kicker">Santo do Dia</div>
    <h3>{santo ? santo.title : "Sem dados para este dia"}</h3>
    <p>Dia {day} de {mes.nome}</p>
  </div>
</a>

<style>
  .santo-resumo {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: minmax(0, 1fr);
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid rgba(210, 182, 117, 0.35);
    background: var(--card);
    box-shadow: 0 24px 40px rgba(0, 0, 0, 0.45);
  }
  .santo-resumo:hover {
    border-color: rgba(210, 182, 117, 0.65);
  }
  .santo-media {
    min-height: 240px;
    background-size: cover;
    background-position: center;
  }
  .santo-body {
    padding: 1.6rem;
  }
  .santo-body h3 {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3vw, 2.3rem);
    margin: 0 0 0.6rem;
  }
  .santo-body p {
    margin: 0;
    color: var(--muted);
  }
  @media (min-width: 900px) {
    .santo-resumo {
      grid-template-columns: 0.9fr 1.1fr;
    }
    .santo-media {
      min-height: 100%;
    }
  }
</style>
