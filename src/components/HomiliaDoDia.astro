---
import { homiliasDez2025 } from "../data/homilia-2025-12";

const now = new Date();
const dateKey = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, "0")}-${String(
  now.getDate()
).padStart(2, "0")}`;
const entry = homiliasDez2025[dateKey];
---

<section class="daily-section">
  <div class="daily-card">
    <div class="daily-content">
      <div class="daily-kicker">Homilia do Dia</div>
      <h3>{entry ? entry.title : "Homilia do Dia"}</h3>
      <p class="daily-text">
        {entry
          ? entry.text
          : "Sem homilia local para este dia. O banco atual cobre dezembro de 2025."}
      </p>
    </div>
  </div>
</section>
