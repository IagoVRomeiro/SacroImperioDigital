---
import ChevronDown from "@lucide/astro/icons/chevron-down";

type Props = {
  title: string;
};

const { title } = Astro.props;
---

<details class="collapse-prayer not-prose group">
  <summary class="flex cursor-pointer list-none items-center gap-2 text-sm/loose font-semibold">
    {title}
    <ChevronDown class="size-4 opacity-50 transition group-open:rotate-180" stroke-width={3} />
  </summary>
  <div class="prose prose-sm mt-1 mb-6 max-w-none">
    <slot />
  </div>
</details>
