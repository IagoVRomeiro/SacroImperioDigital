---
import { Font } from "astro:assets";
import "../styles.css";

type Props = {
  title?: string;
};

const { title = "Terço de Rezas" } = Astro.props;
---

<!doctype html>
<html lang="pt-BR" data-theme="vatican">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <Font cssVariable="--font-serif" preload />
  </head>
  <body class="antialiased site-shell">
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand">
          <img src="/assets/icon.png" alt="Sacro Império Digital" class="brand-mark" />
          <div>
            <div class="brand-title">Sacro Império Digital</div>
            <div class="brand-subtitle"></div>
          </div>
        </a>
        <nav class="site-nav" aria-label="Navegação principal">
          <a class="nav-link" href="/oracoes">Orações</a>
          <a class="nav-link" href="/santo-rosario">Rosário</a>
          <a class="nav-link" href="/santos-do-dia">Santo do Dia</a>
          <a class="nav-link" href="/servir">Servir</a>
        </nav>
      </div>
    </header>
    <main class="main-content">
      <slot />
    </main>
    <footer class="mt-16 border-t border-[var(--accent-soft)] bg-[var(--paper)] shadow-[0_-8px_20px_var(--shadow-soft)]">
      <div class="container py-10">
        <div class="grid gap-8 md:grid-cols-[1.2fr_1fr] md:items-center">
          <div class="space-y-3">
            <div class="text-sm uppercase tracking-[0.25em] text-[color:var(--accent-deep)]">Linktree</div>
            <div class="text-lg font-serif">Siga e acompanhe o Sacro Império Digital</div>
            <p class="text-sm text-[color:var(--ink)]/70">Links oficiais e redes em um só lugar.</p>
          </div>
          <div class="flex flex-wrap gap-3 text-sm font-medium">
            <a class="inline-flex items-center gap-2 rounded-full border border-[var(--accent-soft)] px-4 py-2 transition hover:bg-[color:var(--accent-soft)]/60 hover:text-[color:var(--accent-deep)]" href="https://x.com/DigitalSacro">
              <svg aria-hidden="true" viewBox="0 0 24 24" class="size-4">
                <path fill="currentColor" d="M18.244 2H21.6l-7.38 8.438L22 22h-6.829l-5.35-7.007L3.8 22H.44l7.9-9.02L2 2h6.998l4.83 6.266L18.244 2Zm-1.2 18h1.858L7.06 4H5.073l11.97 16Z"/>
              </svg>
              X (Twitter)
            </a>
            <a class="inline-flex items-center gap-2 rounded-full border border-[var(--accent-soft)] px-4 py-2 transition hover:bg-[color:var(--accent-soft)]/60 hover:text-[color:var(--accent-deep)]" href="https://www.instagram.com/sacroimperiodigital/">
              <svg aria-hidden="true" viewBox="0 0 24 24" class="size-4">
                <path fill="currentColor" d="M7.5 3h9A4.5 4.5 0 0 1 21 7.5v9A4.5 4.5 0 0 1 16.5 21h-9A4.5 4.5 0 0 1 3 16.5v-9A4.5 4.5 0 0 1 7.5 3Zm0 1.5A3 3 0 0 0 4.5 7.5v9a3 3 0 0 0 3 3h9a3 3 0 0 0 3-3v-9a3 3 0 0 0-3-3h-9ZM12 7.5A4.5 4.5 0 1 1 7.5 12 4.5 4.5 0 0 1 12 7.5Zm0 1.5A3 3 0 1 0 15 12a3 3 0 0 0-3-3Zm4.65-2.1a1.05 1.05 0 1 1-1.05 1.05 1.05 1.05 0 0 1 1.05-1.05Z"/>
              </svg>
              Instagram
            </a>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
