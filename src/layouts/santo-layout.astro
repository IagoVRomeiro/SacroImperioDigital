---
import Layout from "./layout.astro";

type Props = {
  frontmatter: {
    title: string;
    subtitle?: string;
    image?: string;
  };
};

const { frontmatter } = Astro.props;
const imageUrl = frontmatter?.image ?? "/assets/fundo.png";
const subtitle = frontmatter?.subtitle ?? "Biografia do santo";
---

<Layout title={frontmatter.title}>
  <div class="container">
    <a href="/santos-do-dia" class="back-to-saints-link">← Voltar para Santos</a>
    <div
      class="saint-hero"
      style={`--saint-image: url('${imageUrl}')`}
    >
      <div class="saint-hero-inner">
        <h1 class="saint-hero-title">{frontmatter.title}</h1>
        <div class="saint-hero-rule" aria-hidden="true"></div>
        <p class="saint-hero-subtitle">{subtitle}</p>
      </div>
    </div>

    <div class="saint-description prose mx-auto max-w-[80ch] font-serif">
      <slot />
    </div>
  </div>
</Layout>

<style is:global>
  .back-to-saints-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 2rem;
    color: var(--accent);
    text-decoration: none;
    font-weight: bold;
    transition: color 0.2s ease;
  }
  .back-to-saints-link:hover {
    color: var(--accent-light);
  }
</style>
