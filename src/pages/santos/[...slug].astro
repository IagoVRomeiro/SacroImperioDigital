---
import { santosDoDia2025, santosDoDia2026 } from "../../data/santos-do-dia";
import SantoLayout from "../../layouts/santo-layout.astro";

const { slug } = Astro.params;
const [month, day] = slug.split("/");
const dayNumber = parseInt(day, 10);

const santosDoDia = Astro.url.pathname.includes("2026") ? santosDoDia2026 : santosDoDia2025;
const saint = santosDoDia[month]?.find((s) => s.day === dayNumber);

if (!saint) {
  return new Response(null, {
    status: 404,
    statusText: 'Not found'
  });
}

const frontmatter = {
  title: saint.title,
  subtitle: `Santo do dia ${day} de ${month}`,
  image: saint.image,
};
---

<SantoLayout frontmatter={frontmatter}>
  <p>{saint.description}</p>
</SantoLayout>
