---
import { getBrasiliaDateParts } from "../utils/brasilia-date";

// Redireciona no servidor para os mistérios do dia da semana (horário de Brasília).
export const prerender = false;

const misterioPorDia = [
  "/misterios-gloriosos-extendida", // domingo
  "/misterios-gozosos-extendida", // segunda
  "/misterios-dolorosos-extendida", // terça
  "/misterios-gloriosos-extendida", // quarta
  "/misterios-luminosos-extendida", // quinta
  "/misterios-dolorosos-extendida", // sexta
  "/misterios-gozosos-extendida", // sábado
];

return Astro.redirect(misterioPorDia[getBrasiliaDateParts().weekday] ?? "/santo-rosario", 302);
---
