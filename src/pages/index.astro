---
import Layout from "../layouts/layout.astro";
import SantoDoDiaResumo from "../components/SantoDoDiaResumo.astro";
import LiturgiaDoDia from "../components/LiturgiaDoDia.astro";
import { frasesDosSantos } from "../data/frases-dos-santos";

// Renderizada a cada visita: santo, liturgia e frase mudam conforme o dia.
export const prerender = false;

const frase = frasesDosSantos[Math.floor(Math.random() * frasesDosSantos.length)];
---

<Layout title="Sacro Império Digital">
  <div class="home">
    <section class="hero">
      <div class="hero-inner container">
        <div class="kicker fade-up" style="--delay: 0.1s">Sacro Império Digital</div>
        <h1 class="hero-title fade-up" style="--delay: 0.2s">{frase.texto}</h1>
        <p class="hero-subtitle fade-up" style="--delay: 0.3s">{frase.autor}</p>
        <div class="hero-actions fade-up" style="--delay: 0.4s">
          <a class="btn btn-primary" href="/rosario-do-dia">Iniciar o Rosário</a>
          <a class="btn btn-outline" href="/oracoes">Explorar Orações</a>
        </div>
      </div>
    </section>

    <section class="compact-section">
      <div class="fade-up container" style="--delay: 0.3s">
        <SantoDoDiaResumo />
      </div>
    </section>

    <section class="compact-section">
      <div class="fade-up container" style="--delay: 0.3s">
        <LiturgiaDoDia />
      </div>
    </section>
  </div>
</Layout>
